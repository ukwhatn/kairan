{
  "name": "kairan",
  "version": "0.1.0",
  "description": "Local MCP server that circulates agent-generated markdown/html documents to your browser",
  "type": "module",
  "bin": {
    "kairan": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts daemon --foreground",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@shikijs/markdown-it": "^4.4.1",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "hono": "^4.12.34",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.0",
    "shiki": "^4.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukwhatn/kairan.git"
  }
}
